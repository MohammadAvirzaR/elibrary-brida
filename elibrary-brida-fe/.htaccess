<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Cache busting untuk asset dengan hash
  <FilesMatch "\.(?:js|css|woff2|png|jpg|jpeg|gif|svg)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # SPA routing: arahkan semua request (bukan file/folder fisik) ke index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(?!api\/).*$ index.html [L]

  # Hindari cache untuk index.html
  <Files "index.html">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
  </Files>

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Security headers
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|woff|woff2|ttf|otf|eot)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
